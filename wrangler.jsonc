{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dps-tabepalu",
  "main": "./worker.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
